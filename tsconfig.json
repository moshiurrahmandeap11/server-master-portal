{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/server": ["./src/shims/next-server.ts"],
      "next/headers": ["./src/shims/next-headers.ts"],
      "next/cache": ["./src/shims/next-cache.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/lib/testing/**/*", "node_modules", "dist"]
}
