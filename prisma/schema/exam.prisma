model ExamNotice {
  id           String       @id @default(uuid())
  jobId        String?
  job          JobCircular? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title        String
  organization String?
  category     String?
  stage        ExamStage    @default(WRITTEN)
  examDate     DateTime?
  examTime     String?
  venue        String?
  description  String?
  noticeUrl    String?
  status       String       @default("published")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("exam_notices")
}

model AdmitCard {
  id               String       @id @default(uuid())
  jobId            String?
  job              JobCircular? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title            String
  organization     String?
  category         String?
  examDate         DateTime?
  deadline         DateTime?
  downloadUrl      String?
  rollInstructions String?
  isAvailable      Boolean      @default(true)
  status           String       @default("available")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("admit_cards")
}

model ExamResult {
  id           String       @id @default(uuid())
  jobId        String?
  job          JobCircular? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title        String
  organization String?
  category     String?
  stage        ExamStage    @default(WRITTEN)
  summary      String?
  pdfUrl       String?
  passedRolls  Json?        // Array of passed roll numbers
  publishedAt  DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("exam_results")
}

model VivaNotice {
  id           String    @id @default(uuid())
  title        String
  organization String?
  category     String?
  vivaDate     DateTime?
  venue        String?
  instructions String?
  noticeUrl    String?
  status       String    @default("published")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("viva_notices")
}

model Question {
  id           String   @id @default(uuid())
  category     String   // Bangla, English, Math, General Knowledge, etc.
  question     String
  options      Json     // Array of choices [optionA, optionB, optionC, optionD]
  correctIndex Int
  explanation  String?
  examYear     Int?
  organization String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("questions")
}

model ModelTest {
  id              String             @id @default(uuid())
  title           String
  category        String
  description     String?
  totalMarks      Int                @default(100)
  durationMinutes Int                @default(60)
  negativeMark    Float              @default(0.25)
  isPublished     Boolean            @default(true)
  questions       Json               // Array of questions / question IDs
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attempts        ModelTestAttempt[]

  @@map("model_tests")
}

model ModelTestAttempt {
  id             String    @id @default(uuid())
  candidateId    String
  modelTestId    String
  modelTest      ModelTest @relation(fields: [modelTestId], references: [id], onDelete: Cascade)
  category       String
  totalQuestions Int
  correctCount   Int
  wrongCount     Int
  skippedCount   Int       @default(0)
  score          Float
  totalMarks     Int
  accuracy       Float
  durationSec    Int?
  answers        Json?
  createdAt      DateTime  @default(now())

  @@index([candidateId])
  @@index([modelTestId])
  @@map("model_test_attempts")
}
