model EducationRecord {
  id              String    @id @default(uuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  level           String
  examTitle       String
  groupMajor      String?
  boardUniversity String?
  institute       String?
  rollNumber      String?
  regNumber       String?
  passingYear     Int
  resultType      String?
  gpaCgpa             Float?
  scale               Float?
  verificationStatus  String    @default("pending")
  verificationRemarks String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("education_records")
}

model CandidateDocument {
  id                  String       @id @default(uuid())
  candidateId         String
  candidate           Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type                DocumentType
  slotType            String?
  category            String?
  title               String
  fileUrl             String
  fileSize            Int?
  mimeType            String?
  isVerified          Boolean      @default(false)
  verificationStatus  String       @default("pending")
  verificationRemarks String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("candidate_documents")
}

model SavedJob {
  id          String      @id @default(uuid())
  candidateId String
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         JobCircular @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([candidateId, jobId])
  @@map("saved_jobs")
}
