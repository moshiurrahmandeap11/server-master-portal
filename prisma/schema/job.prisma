model JobCircular {
  id               String       @id
  slug             String       @unique
  title            String
  titleBn          String?
  organization     String
  organizationSlug String?
  categoryId       String?
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  deadline         DateTime
  totalPositions   Int          @default(1)
  officialFee      Decimal      @default(0.00) @db.Decimal(10, 2)
  serviceFee       Decimal      @default(50.00) @db.Decimal(10, 2)
  sourceUrl        String?
  officialPdfUrl   String?
  bannerUrl        String?
  positions        Json         // Array of sub-positions with salary grade, vacancy, requirements
  eligibility      Json?        // District catchment, age limit rules
  instructions     Json?        // Teletalk / Online application steps
  status           JobStatus    @default(PUBLISHED)
  isFeatured       Boolean      @default(false)
  viewsCount       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  applications  ApplicationRequest[]
  savedBy       SavedJob[]
  examNotices   ExamNotice[]
  admitCards    AdmitCard[]
  examResults   ExamResult[]
  userReminders UserJobReminder[]

  @@map("job_circulars")
}

model Category {
  id          String        @id
  slug        String        @unique
  titleBn     String
  titleEn     String
  icon        String?
  description String?
  parentSlug  String?
  isActive    Boolean       @default(true)
  orderIndex  Int           @default(0)
  jobs        JobCircular[]

  @@map("categories")
}

model Organization {
  id         String   @id
  name       String
  nameBn     String?
  slug       String   @unique
  logoUrl    String?
  websiteUrl String?
  type       String?  // Govt, Autonomous, Bank, Private
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("organizations")
}

model JobSource {
  id           String    @id
  name         String
  targetUrl    String
  type         String?   @default("rss")
  frequency    String    @default("hourly")
  isEnabled    Boolean   @default(true)
  trustScore   Int       @default(90)
  lastRunAt    DateTime?
  healthStatus String    @default("healthy")
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("job_sources")
}

model CircularDraft {
  id            String   @id @default(uuid())
  title         String
  rawSourceData Json
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("circular_drafts")
}
