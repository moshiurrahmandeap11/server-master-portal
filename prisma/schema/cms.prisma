model PageRecord {
  id              String    @id
  slug            String    @unique
  title           String
  metaTitle       String?
  metaDescription String?
  status          String    @default("published")
  version         Int       @default(1)
  isSystemPage    Boolean   @default(false)
  sections        Json      // Array of Page Builder Sections
  revisions       Json?
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("pages")
}

model MediaItem {
  id           String   @id @default(uuid())
  filename     String
  originalName String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  altText      String?
  caption      String?
  category     String?  @default("general")
  dimensions   Json?
  createdAt    DateTime @default(now())

  @@map("media_items")
}

model PlatformSettings {
  id           String   @id @default("global")
  siteName     String   @default("চাকরি সেবা")
  tagline      String?
  contactEmail String?
  supportPhone String?
  headerMenu   Json?
  footerMenu   Json?
  seoDefaults  Json?
  general      Json?
  workflow     Json?
  operational  Json?
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  kind        String   @default("blog") // blog | guide
  title       String
  excerpt     String?
  content     String
  category    String?
  author      String?
  coverImage  String?
  readTime    String?
  tags        Json?
  status      String   @default("published")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, status])
  @@map("blog_posts")
}

model CandidateReview {
  id          String   @id @default(uuid())
  name        String
  role        String?
  institution String?
  quote       String
  rating      Int      @default(5)
  isApproved  Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("candidate_reviews")
}
