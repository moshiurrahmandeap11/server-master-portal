PORT=6969
NODE_ENV=development
FRONTEND_URL=http://localhost:3050
CHAKRI_DB_FILE=./src/db/local_store.json
CHAKRI_UPLOAD_DIR=./uploads
ADMIN_SECRET_KEY=change_this_admin_secret_key

# JWT Dual-Token Secrets (Use strong 32+ char random strings in production)
ACCESS_TOKEN_SECRET=your_access_token_jwt_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_jwt_secret_min_32_chars
COOKIE_SECURE=false

# Email Verification & Password Reset OTP (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password
SMTP_FROM="চাকরি সেবা <your-email@gmail.com>"

# Google OAuth 2.0 (Same Client ID as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Neon PostgreSQL Database (Prisma Migration Target)
DATABASE_URL=postgresql://user:password@ep-your-instance.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Object Storage (S3-compatible, Zero Egress Fees)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=chakri-sheba-storage
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxxxxxx.r2.dev

