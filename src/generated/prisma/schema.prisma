generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// Module: admin.prisma
// -----------------------------------------------------
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("admin_audit_logs")
}

model NotificationItem {
  id          String    @id
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String    @default("info")
  isRead      Boolean   @default(false)
  actionUrl   String?
  createdAt   DateTime  @default(now())

  @@map("notifications")
}

model UserJobReminder {
  id              String      @id @default(uuid())
  candidateId     String
  candidate       Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobCircular @relation(fields: [jobId], references: [id], onDelete: Cascade)
  alertDaysBefore Int         @default(1)
  createdAt       DateTime    @default(now())

  @@map("user_job_reminders")
}

model DeadlineAlertRule {
  id        String   @id @default(uuid())
  name      String
  condition String
  channels  Json
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("deadline_alert_rules")
}

model JobReport {
  id             String   @id @default(uuid())
  jobId          String
  candidateEmail String?
  reason         String
  details        String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  @@map("job_reports")
}

model JobAlertSubscription {
  id         String   @id @default(uuid())
  email      String
  categories Json?
  frequency  String   @default("daily")
  createdAt  DateTime @default(now())

  @@map("job_alert_subscriptions")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// -----------------------------------------------------
// Module: application.prisma
// -----------------------------------------------------
model ApplicationRequest {
  id                  String            @id
  candidateId         String
  candidate           Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId               String
  job                 JobCircular       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  positionIndex       Int               @default(0)
  positionName        String
  trackingNumber      String            @unique
  status              ApplicationStatus @default(PENDING)
  govtFee             Decimal           @db.Decimal(10, 2)
  serviceFee          Decimal           @db.Decimal(10, 2)
  discount            Decimal           @default(0.00) @db.Decimal(10, 2)
  totalPaid           Decimal           @db.Decimal(10, 2)
  paymentMethod       String            @default("wallet")
  transactionId       String?
  applicantCopyPdfUrl String?
  teletalkUserId      String?
  rollNumber          String?
  operatorNotes       String?
  statusHistory       Json? // Array of status changes [{status, timestamp, note}]
  submittedAt         DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("application_requests")
}

model CompanyProfile {
  id          String   @id
  companyName String
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profiles")
}

model CompanyApplication {
  id          String   @id @default(uuid())
  companyId   String
  candidateId String
  jobId       String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_applications")
}

// -----------------------------------------------------
// Module: auth.prisma
// -----------------------------------------------------
model Candidate {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?    @unique
  username        String     @unique
  name            String
  nameBn          String?
  passwordHash    String
  role            UserRole   @default(CANDIDATE)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  walletBalance   Decimal    @default(0.00) @db.Decimal(12, 2)
  district        String?
  division        String?
  avatarUrl       String?
  googleId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Extended Smart Profile Fields (Govt / Teletalk / Bank Standard)
  fatherName              String?
  fatherNameBn            String?
  motherName              String?
  motherNameBn            String?
  fatherNid               String?
  motherNid               String?
  dob                     String?
  gender                  String?  @default("male")
  nid                     String?
  address                 String?
  permanentAddress        String?
  sameAsPresentAddress    Boolean? @default(true)
  maritalStatus           String?  @default("single")
  religion                String?
  nationality             String?  @default("বাংলাদেশি (Bangladeshi)")
  photoUrl                String?
  signatureUrl            String?
  nidFrontUrl             String?
  nidBackUrl              String?
  fatherNidUrl            String?
  motherNidUrl            String?
  nagorikCertificateUrl   String?
  birthCertificateUrl     String?
  characterCertificateUrl String?
  quota                   String?  @default("none")
  quotaCertificateUrl     String?
  skills                  Json?    @default("[]")
  experiences             Json?    @default("[]")
  presentAddressDetails   Json?
  permanentAddressDetails Json?
  careerObjective         String?
  professionalSummary     String?
  currentPosition         String?
  currentOrganization     String?
  careerPreferences       Json?

  sessions          Session[]
  documents         CandidateDocument[]
  educations        EducationRecord[]
  applications      ApplicationRequest[]
  transactions      WalletTransaction[]
  savedJobs         SavedJob[]
  notifications     NotificationItem[]
  jobReminders      UserJobReminder[]
  couponRedemptions CouponRedemption[]
  raffleEntries     RaffleEntry[]

  @@map("candidates")
}

model Session {
  id           String    @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("sessions")
}

model VerificationOtp {
  id          String   @id @default(uuid())
  email       String
  otp         String
  type        OtpType  @default(VERIFY_EMAIL)
  candidateId String?
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("verification_otps")
}

model StaffMember {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  role        UserRole @default(OPERATOR)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("staff_members")
}

// -----------------------------------------------------
// Module: candidate.prisma
// -----------------------------------------------------
model EducationRecord {
  id              String    @id @default(uuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  level           String
  examTitle       String
  groupMajor      String?
  boardUniversity String?
  institute       String?
  rollNumber      String?
  regNumber       String?
  passingYear     Int
  resultType      String?
  gpaCgpa         Float?
  scale           Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("education_records")
}

model CandidateDocument {
  id          String       @id @default(uuid())
  candidateId String
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        DocumentType
  title       String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("candidate_documents")
}

model SavedJob {
  id          String      @id @default(uuid())
  candidateId String
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         JobCircular @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([candidateId, jobId])
  @@map("saved_jobs")
}

// -----------------------------------------------------
// Module: cms.prisma
// -----------------------------------------------------
model PageRecord {
  id              String    @id
  slug            String    @unique
  title           String
  metaTitle       String?
  metaDescription String?
  status          String    @default("published")
  version         Int       @default(1)
  isSystemPage    Boolean   @default(false)
  sections        Json // Array of Page Builder Sections
  revisions       Json?
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("pages")
}

model MediaItem {
  id         String   @id @default(uuid())
  filename   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  dimensions Json?
  createdAt  DateTime @default(now())

  @@map("media_items")
}

model PlatformSettings {
  id           String   @id @default("global")
  siteName     String   @default("চাকরি সেবা")
  tagline      String?
  contactEmail String?
  supportPhone String?
  headerMenu   Json?
  footerMenu   Json?
  seoDefaults  Json?
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}

// -----------------------------------------------------
// Module: enums.prisma
// -----------------------------------------------------
enum UserRole {
  CANDIDATE
  ADMIN
  OPERATOR
  EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum OtpType {
  VERIFY_EMAIL
  RESET_PASSWORD
  LOGIN_OTP
}

enum ApplicationStatus {
  PENDING
  PROCESSING
  PAYMENT_COMPLETED
  COMPLETED
  REJECTED
  CANCELLED
}

enum TransactionType {
  RECHARGE
  APPLICATION_FEE
  REFUND
  CASHBACK
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum ExamStage {
  MCQ
  WRITTEN
  PRACTICAL
  VIVA
}

enum DocumentType {
  PHOTO_300x300
  SIGNATURE_300x80
  NID_CARD
  BIRTH_CERTIFICATE
  SSC_CERTIFICATE
  HSC_CERTIFICATE
  GRADUATION_CERTIFICATE
  MASTERS_CERTIFICATE
  QUOTA_CERTIFICATE
  OTHER
}

// -----------------------------------------------------
// Module: exam.prisma
// -----------------------------------------------------
model ExamNotice {
  id        String       @id @default(uuid())
  jobId     String?
  job       JobCircular? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title     String
  stage     ExamStage    @default(WRITTEN)
  examDate  DateTime?
  venue     String?
  noticeUrl String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("exam_notices")
}

model AdmitCard {
  id               String      @id @default(uuid())
  jobId            String
  job              JobCircular @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title            String
  downloadUrl      String?
  rollInstructions String?
  isAvailable      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("admit_cards")
}

model ExamResult {
  id          String      @id @default(uuid())
  jobId       String
  job         JobCircular @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String
  stage       ExamStage   @default(WRITTEN)
  pdfUrl      String?
  passedRolls Json? // Array of passed roll numbers
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("exam_results")
}

model Question {
  id           String   @id @default(uuid())
  category     String // Bangla, English, Math, General Knowledge, etc.
  question     String
  options      Json // Array of choices [optionA, optionB, optionC, optionD]
  correctIndex Int
  explanation  String?
  examYear     Int?
  organization String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("questions")
}

model ModelTest {
  id              String   @id @default(uuid())
  title           String
  category        String
  totalMarks      Int      @default(100)
  durationMinutes Int      @default(60)
  questions       Json // Array of questions / question IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("model_tests")
}

// -----------------------------------------------------
// Module: job.prisma
// -----------------------------------------------------
model JobCircular {
  id               String    @id
  slug             String    @unique
  title            String
  titleBn          String?
  organization     String
  organizationSlug String?
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  deadline         DateTime
  totalPositions   Int       @default(1)
  officialFee      Decimal   @default(0.00) @db.Decimal(10, 2)
  serviceFee       Decimal   @default(50.00) @db.Decimal(10, 2)
  sourceUrl        String?
  officialPdfUrl   String?
  bannerUrl        String?
  positions        Json // Array of sub-positions with salary grade, vacancy, requirements
  eligibility      Json? // District catchment, age limit rules
  instructions     Json? // Teletalk / Online application steps
  status           JobStatus @default(PUBLISHED)
  isFeatured       Boolean   @default(false)
  viewsCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  applications  ApplicationRequest[]
  savedBy       SavedJob[]
  examNotices   ExamNotice[]
  admitCards    AdmitCard[]
  examResults   ExamResult[]
  userReminders UserJobReminder[]

  @@map("job_circulars")
}

model Category {
  id         String        @id
  slug       String        @unique
  titleBn    String
  titleEn    String
  icon       String?
  orderIndex Int           @default(0)
  jobs       JobCircular[]

  @@map("categories")
}

model Organization {
  id         String   @id
  name       String
  nameBn     String?
  slug       String   @unique
  logoUrl    String?
  websiteUrl String?
  type       String? // Govt, Autonomous, Bank, Private
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("organizations")
}

model JobSource {
  id           String    @id
  name         String
  targetUrl    String
  frequency    String    @default("hourly")
  lastRunAt    DateTime?
  healthStatus String    @default("healthy")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("job_sources")
}

model CircularDraft {
  id            String   @id @default(uuid())
  title         String
  rawSourceData Json
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("circular_drafts")
}

// -----------------------------------------------------
// Module: wallet.prisma
// -----------------------------------------------------
model WalletTransaction {
  id          String            @id
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  amount      Decimal           @db.Decimal(12, 2)
  type        TransactionType
  method      String            @default("wallet")
  trxId       String?
  status      TransactionStatus @default(COMPLETED)
  description String?
  referenceId String?
  createdAt   DateTime          @default(now())

  @@map("wallet_transactions")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(FIXED)
  discountValue Decimal      @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  minSpend      Decimal?     @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  status        CouponStatus @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id              String    @id @default(uuid())
  couponId        String
  coupon          Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  discountApplied Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())

  @@map("coupon_redemptions")
}

model RaffleCampaign {
  id           String        @id @default(uuid())
  title        String
  rewardAmount Decimal       @db.Decimal(10, 2)
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  entries      RaffleEntry[]

  @@map("raffle_campaigns")
}

model RaffleEntry {
  id          String         @id @default(uuid())
  campaignId  String
  campaign    RaffleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@map("raffle_entries")
}
